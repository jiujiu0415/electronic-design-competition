/**
 * 第6步: ADC采集 + FFT分析 — 完整 main.c 用户代码
 *
 * 4个用户文件 (放 CubeIDE 工程对应目录):
 *   Core/Inc/dac_wave.h   Core/Src/dac_wave.c
 *   Core/Inc/adc_fft.h    Core/Src/adc_fft.c
 *
 * 硬件: PA4 ↔ PA0 杜邦线短接
 */

/* ============================================================
 * ① USER CODE BEGIN Includes — 顶部
 * ============================================================ */
#include "dac_wave.h"
#include "adc_fft.h"
#include "stdio.h"
#include "string.h"

/* ============================================================
 * ② USER CODE BEGIN PD — 空
 * ============================================================ */

/* ============================================================
 * ③ USER CODE BEGIN PV — 全局变量
 * ============================================================ */
char tx_buf[512];

/* ============================================================
 * ④ USER CODE BEGIN 0 — 自定义函数 (放在文件尾部)
 * ============================================================ */
void uart_print(char *msg)
{
    HAL_UART_Transmit(&huart2, (uint8_t *)msg, strlen(msg), 1000);
}
/* 注意: HAL_ADC_ConvCpltCallback 在 adc_fft.c 里, 这里不要重复定义 */

/* ============================================================
 * ⑤ USER CODE BEGIN 2 — main() 初始化区
 * ============================================================ */

  uart_print("=== System Boot ===\r\n");

  /* 启动 DAC */
  DAC_Wave_Init();
  DAC_Wave_SetFreq(DAC_CHANNEL_2, 3000.0f);
  DAC_Wave_SetType(DAC_CHANNEL_2, WAVE_TRIANGLE);
  DAC_Wave_Update(DAC_CHANNEL_2);
  uart_print("DAC started\r\n");

  /* 启动 ADC+FFT */
  ADC_FFT_Init();
  snprintf(tx_buf, sizeof(tx_buf), "ADC started, Fs=%.0f Hz\r\n\r\n",
           ADC_FFT_GetSampleRate());
  uart_print(tx_buf);

/* ============================================================
 * ⑥ USER CODE BEGIN 3 — while(1) 主循环
 * ============================================================ */

  if (ADC_FFT_DataReady())
  {
      FFT_Result r = ADC_FFT_Analyze();

      snprintf(tx_buf, sizeof(tx_buf),
               "ZC:%.1f Hz | FFT:%.1f Hz | Amp:%.3f | Wave:%s\r\n",
               r.freq_zc, r.peaks[0].freq_hz,
               r.peaks[0].amplitude, r.waveform);
      uart_print(tx_buf);

      /* 打印所有检测到的峰 */
      for (uint8_t i = 0; i < r.peak_count; i++)
      {
          snprintf(tx_buf, sizeof(tx_buf),
                   "  Peak%d: %.1f Hz  amp=%.3f\r\n",
                   i + 1, r.peaks[i].freq_hz, r.peaks[i].amplitude);
          uart_print(tx_buf);
      }
      uart_print("---\r\n");
  }

/* ============================================================
 * main.h — USER CODE BEGIN Private defines
 * ============================================================ */
// 不需要额外声明
