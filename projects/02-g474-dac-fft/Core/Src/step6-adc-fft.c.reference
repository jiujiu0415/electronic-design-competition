/**
 * 第6步: ADC采集 + FFT分析 v2
 *
 * 新功能:
 *   - 过零检测辅助测频 (精度远高于 FFT bin)
 *   - 多峰值检测 (叠加信号分离)
 *   - 自动识别波形类型 (正弦/三角/方波/锯齿/叠加)
 *
 * 硬件: PA4 ↔ PA0 杜邦线短接
 */

/* ============================================================
 * main.c 完整用户代码
 * ============================================================ */

/* ① USER CODE BEGIN Includes */
#include "dac_wave.h"
#include "adc_fft.h"
#include "stdio.h"
#include "string.h"
/* USER CODE END Includes */

/* ② USER CODE BEGIN PD */
// 空
/* USER CODE END PD */

/* ③ USER CODE BEGIN PV */
char tx_buf[512];
/* USER CODE END PV */

/* ④ USER CODE BEGIN 0 */
void uart_print(char *msg)
{
    HAL_UART_Transmit(&huart2, (uint8_t *)msg, strlen(msg), 1000);
}
/* USER CODE END 0 */

/* ⑤ USER CODE BEGIN 2 */
  /* USER CODE BEGIN 2 */

  DAC_Wave_Init();
  ADC_FFT_Init();

  uart_print("\r\n=== DAC-ADC-FFT System v2 ===\r\n");
  snprintf(tx_buf, sizeof(tx_buf), "Sample rate: %.0f Hz, FFT: %d pts\r\n\r\n",
           ADC_FFT_GetSampleRate(), FFT_SIZE);
  uart_print(tx_buf);

  /* USER CODE END 2 */

/* ⑥ USER CODE BEGIN 3 */
  /* USER CODE BEGIN 3 */

  if (ADC_FFT_DataReady())
  {
      FFT_Result r = ADC_FFT_Analyze();

      /* 标题行 */
      snprintf(tx_buf, sizeof(tx_buf),
               "--- FFT Result | DC:%.2fV | ZC:%.1f Hz | Wave:%s ---\r\n",
               r.dc_offset_v, r.freq_zc, r.waveform);
      uart_print(tx_buf);

      /* 每个峰 */
      for (uint8_t i = 0; i < r.peak_count; i++)
      {
          snprintf(tx_buf, sizeof(tx_buf),
                   "  Peak%d: %7.1f Hz  amp=%.3f  phase=%.1f deg\r\n",
                   i + 1, r.peaks[i].freq_hz, r.peaks[i].amplitude,
                   r.peaks[i].phase_deg);
          uart_print(tx_buf);
      }

      uart_print("\r\n");
  }

  /* USER CODE END 3 */
