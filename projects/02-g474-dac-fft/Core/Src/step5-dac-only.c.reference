/**
 * 第5步: DAC波形输出（使用 dac_wave 模块）
 *
 * 硬件: STM32G474RET6, HSI→PLL→160MHz
 * 引脚: PA4=DAC1_OUT1, PA5=DAC1_OUT2
 *
 * ⚠️ CubeMX 前置要求:
 *   DAC1 DMA → Data Width (Peripheral) = WORD (G4的DAC在AHB总线)
 *   DAC1 DMA → Data Width (Memory)    = Half Word
 */

/* ============================================================
 * ① USER CODE BEGIN Includes
 * ============================================================ */
#include "dac_wave.h"
#include "stdio.h"

/* ============================================================
 * ② USER CODE BEGIN PD
 * ============================================================ */
// (不需要宏, dac_wave.h 里都有了)

/* ============================================================
 * ③ USER CODE BEGIN PV
 * ============================================================ */
char tx_buf[128];

/* ============================================================
 * ④ USER CODE BEGIN 0
 * ============================================================ */

/* printf 重定向 */
#ifdef __GNUC__
int _write(int fd, char *ptr, int len)
{
    HAL_UART_Transmit(&huart2, (uint8_t *)ptr, len, 100);
    return len;
}
#endif

/* ============================================================
 * ⑤ USER CODE BEGIN 2 — main() 初始化区
 * ============================================================ */
  /* USER CODE BEGIN 2 */

  /* 初始化 DAC, 默认两路 1kHz 正弦 */
  DAC_Wave_Init();

  printf("\r\n=== DAC Wave Module Ready ===\r\n");
  printf("PA4: 1kHz sine  (默认信号源)\r\n");
  printf("PA5: 1kHz sine  (默认输出)\r\n");
  printf("=============================\r\n\r\n");

  /* ── 演示: 把 PA5 改成 5kHz 三角波 ── */
  float actual = DAC_Wave_SetFreq(DAC_CHANNEL_2, 5000.0f);
  DAC_Wave_SetAmplitude(DAC_CHANNEL_2, 0.5f);
  DAC_Wave_SetType(DAC_CHANNEL_2, WAVE_TRIANGLE);
  DAC_Wave_Update(DAC_CHANNEL_2);
  printf("PA5 changed: %.0f Hz triangle\r\n", actual);

  /* USER CODE END 2 */

/* ============================================================
 * ⑥ USER CODE BEGIN 3 — while(1) 主循环
 * ============================================================ */
  /* USER CODE BEGIN 3 */
  /* 下一步加 ADC 采集 */
  /* USER CODE END 3 */

/* ============================================================
 * 文件结构:
 *
 *   Core/Inc/dac_wave.h    ← 接口
 *   Core/Src/dac_wave.c    ← 实现
 *   Core/Src/main.c        ← 只调用 API
 *
 * API 速查:
 *   DAC_Wave_Config(ch, freq, amp, phase, type) → 改全部参数
 *   DAC_Wave_SetFreq(ch, freq)                  → 只改频率
 *   DAC_Wave_SetAmplitude(ch, amp)              → 只改幅度
 *   DAC_Wave_SetPhase(ch, deg)                  → 只改相位
 *   DAC_Wave_SetType(ch, WAVE_SINE/...)         → 只改波形
 *   DAC_Wave_Update(ch)                         → 应用更改
 *   DAC_Wave_Stop(ch) / DAC_Wave_Start(ch)      → 启停
 *
 * 波形类型: WAVE_SINE / WAVE_TRIANGLE / WAVE_SQUARE / WAVE_SAWTOOTH
 * ============================================================ */
