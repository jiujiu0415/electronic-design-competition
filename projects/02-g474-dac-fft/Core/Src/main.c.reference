/**
 * main.c 修改指南 — DAC波形生成 + ADC采集 + FFT分析
 *
 * 本文件记录了需要在 CubeIDE 生成的 main.c 中填入的用户代码。
 * 对应区域: USER CODE BEGIN/END 标记之间。
 *
 * 硬件: STM32G474RET6, HSI→PLL→160MHz
 * DAC更新率: 100kHz (TIM6)
 * ADC采样率: 250kHz (TIM2)
 */

/* ============================================================
 * ① USER CODE BEGIN Includes (顶部)
 * ============================================================ */
#include "arm_math.h"
#include "math.h"
#include "stdio.h"
#include "string.h"

/* ============================================================
 * ② USER CODE BEGIN PD (宏定义)
 * ============================================================ */
#define PI              3.14159265359f
#define DAC_BUF_SIZE    2048
#define ADC_BUF_SIZE    2048
#define FFT_SIZE        1024

/* TIM6 更新率 = 160MHz / (159+1) / (9+1) = 100kHz */
#define DAC_UPDATE_RATE 100000.0f

/* 信号源频率: 1kHz (DAC_UPDATE_RATE / SOURCE_FREQ 必须为整数) */
#define SOURCE_FREQ     1000.0f

/* 每周期数据点数 = 100kHz / 1kHz = 100 */
#define DAC_RATIO       ((uint16_t)(DAC_UPDATE_RATE / SOURCE_FREQ))

/* ============================================================
 * ③ USER CODE BEGIN PV (全局变量)
 * ============================================================ */
/* DAC 波形表 */
uint16_t dac_buf_ch1[DAC_BUF_SIZE];  /* PA4: 信号源 */
uint16_t dac_buf_ch2[DAC_BUF_SIZE];  /* PA5: 同频可控输出 */

/* ADC DMA 缓冲区 */
uint16_t adc_buf[ADC_BUF_SIZE];
volatile uint8_t adc_full_flag = 0;

/* FFT */
arm_rfft_fast_instance_f32 fft_inst;
float32_t fft_in[FFT_SIZE];
float32_t fft_out[FFT_SIZE * 2];
float32_t fft_mag[FFT_SIZE];

/* 串口缓冲 */
char tx_buf[256];

/* ============================================================
 * ④ USER CODE BEGIN 0 (自定义函数)
 * ============================================================ */

/* --- printf 重定向到 USART2 --- */
#ifdef __GNUC__
int _write(int fd, char *ptr, int len)
{
    HAL_UART_Transmit(&huart2, (uint8_t *)ptr, len, 100);
    return len;
}
#endif

/**
 * ADMIN_Init() — 系统初始化
 *
 * 流程:
 *   1. 生成 DAC1 正弦波波形表 (信号源)
 *   2. 生成 DAC2 正弦波波形表 (同频输出，初始相同)
 *   3. 初始化 FFT
 *   4. 启动 TIM6 + TIM2
 *   5. 校准并启动 ADC DMA
 *   6. 启动 DAC DMA (双通道同步)
 */
void ADMIN_Init(void)
{
    float amp_factor = 0.8f;  /* 幅度系数: 0.8 = Vpp约2.6V */

    /* 1. 生成 DAC1 信号源波形 */
    for (uint16_t i = 0; i < DAC_RATIO; i++)
    {
        float phase = 2.0f * PI * i / (float)DAC_RATIO;
        float value = 2048.0f + 2047.0f * amp_factor * arm_cos_f32(phase);
        dac_buf_ch1[i] = (uint16_t)value;
    }

    /* 2. 生成 DAC2 输出波形 (初始和DAC1一致) */
    for (uint16_t i = 0; i < DAC_RATIO; i++)
    {
        float phase = 2.0f * PI * i / (float)DAC_RATIO;
        float value = 2048.0f + 2047.0f * amp_factor * arm_cos_f32(phase);
        dac_buf_ch2[i] = (uint16_t)value;
    }

    /* 3. 初始化 FFT */
    arm_rfft_fast_init_f32(&fft_inst, FFT_SIZE);

    /* 4. 启动定时器 */
    HAL_TIM_Base_Start(&htim6);  /* DAC 触发源 */
    HAL_TIM_Base_Start(&htim2);  /* ADC 触发源 */

    /* 5. ADC 校准 + 启动 DMA */
    HAL_ADCEx_Calibration_Start(&hadc1, ADC_SINGLE_ENDED);
    HAL_ADC_Start_DMA(&hadc1, (uint32_t *)adc_buf, ADC_BUF_SIZE);

    /* 6. 启动 DAC DMA (双通道循环输出) */
    HAL_DAC_Start_DMA(&hdac1, DAC_CHANNEL_1,
                      (uint32_t *)dac_buf_ch1, DAC_RATIO, DAC_ALIGN_12B_R);
    HAL_DAC_Start_DMA(&hdac1, DAC_CHANNEL_2,
                      (uint32_t *)dac_buf_ch2, DAC_RATIO, DAC_ALIGN_12B_R);

    /* 打印状态 */
    printf("\r\n================================\r\n");
    printf("  STM32G474 DAC-ADC-FFT 启动\r\n");
    printf("================================\r\n");
    printf("DAC1 (PA4): %.0f Hz  信号源\r\n", SOURCE_FREQ);
    printf("DAC2 (PA5): %.0f Hz  同频输出\r\n", SOURCE_FREQ);
    printf("DAC 更新率 : %.0f kHz\r\n", DAC_UPDATE_RATE / 1000.0f);
    printf("每周期点数 : %d\r\n", DAC_RATIO);
    printf("ADC 缓冲   : %d\r\n", ADC_BUF_SIZE);
    printf("================================\r\n\r\n");
}

/* ============================================================
 * ⑤ USER CODE BEGIN 2 (main函数初始化区)
 * ============================================================ */
// 替换原来的 MX_xxx_Init() 后面的初始化代码:
ADMIN_Init();

/* ============================================================
 * ⑥ USER CODE BEGIN 3 (while(1)主循环)
 * ============================================================ */
// 当前版本: 仅检测 ADC 完成标志并打印状态
// 下一阶段: 加入 FFT 分析 + 动态更新 DAC2 输出
if (adc_full_flag)
{
    adc_full_flag = 0;

    /* 打印简单状态信息 */
    memset(tx_buf, 0, sizeof(tx_buf));
    snprintf(tx_buf, sizeof(tx_buf),
             "ADC data ready, buffer=%d\r\n", ADC_BUF_SIZE);
    HAL_UART_Transmit(&huart2, (uint8_t *)tx_buf, strlen(tx_buf), 100);

    /* 重新启动 ADC */
    HAL_ADC_Start_DMA(&hadc1, (uint32_t *)adc_buf, ADC_BUF_SIZE);
}
